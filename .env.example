# ---------------------------------------------------------------------------
# Spikerz QA Account Tool — environment configuration (EXAMPLE)
# Copy to `.env` and fill in locally. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Path to the SQLite database file (created automatically if missing).
QA_DB_PATH=./data/qa.db

# Default environment tag applied to the inventory / reports.
QA_ENVIRONMENT=qa

# ---------------------------------------------------------------------------
# Credential references
# ---------------------------------------------------------------------------
# The tool NEVER stores passwords, tokens, or cookies in the database.
# The inventory stores only a credential-reference ID (e.g. CRED-LI-001).
# The actual secret is resolved at runtime from an environment variable named
# QA_CRED_<REFERENCE_ID>: uppercased, non-alphanumerics replaced by "_",
# leading "CRED_" dropped.
#
# Example: inventory row with credential_ref_id = "CRED-LI-001"
#          resolves from QA_CRED_LI_001 below.
#
# In CI / production these come from a secrets manager (GitHub Actions
# encrypted secrets, Vault, AWS/GCP Secrets Manager, ...), not from a file.
# The mock platform layer does not need them; `npm run cli -- creds` shows
# which references currently resolve, without printing any value.

QA_CRED_LI_001=
QA_CRED_LI_002=
QA_CRED_LI_003=
QA_CRED_FB_001=
QA_CRED_FB_002=
QA_CRED_FB_003=
QA_CRED_IG_001=
QA_CRED_IG_002=
QA_CRED_IG_003=
QA_CRED_TT_001=
QA_CRED_TT_002=
QA_CRED_TT_003=
QA_CRED_X_001=
QA_CRED_X_002=
QA_CRED_X_003=

# ---------------------------------------------------------------------------
# Alerting (optional). Leave blank to log alerts to stdout only.
# ---------------------------------------------------------------------------
QA_ALERT_WEBHOOK_URL=

# Name recorded in the audit trail for changes made from this machine.
QA_ACTOR=

# Scripted events for the mock platform layer.
QA_SCENARIOS=data/mock-scenarios.json
